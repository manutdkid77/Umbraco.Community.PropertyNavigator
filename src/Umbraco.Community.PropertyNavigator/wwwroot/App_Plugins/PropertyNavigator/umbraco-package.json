{
  "$schema": "../../umbraco-package-schema.json",
  "id": "Umbraco.Community.PropertyNavigator",
  "name": "Umbraco.Community.PropertyNavigator",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "workspaceFooterApp",
      "alias": "propertyNavigation.workspaceFooterApp.dropdown",
      "name": "Property Navigator - Content View Dropdown",
      "element": "/App_Plugins/PropertyNavigator/property-navigator-dropdown.js",
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Document"
        }
      ]
    }
  ]
}
